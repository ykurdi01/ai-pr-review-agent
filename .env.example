# Diese Datei zu .env kopieren, um lokal zu testen. Die echte .env niemals committen.

# API-Key des verwendeten Sprachmodell-Anbieters.
AI_API_KEY=sk-...

# Ein GitHub-Token mit `repo`- (bzw. fein granuliertem "Pull requests: write"-)
# Zugriff. Im GitHub-Actions-Workflow wird das automatisch als
# secrets.GITHUB_TOKEN bereitgestellt — hier nur für lokale Tests nötig.
GITHUB_TOKEN=ghp_...

# Das zu reviewende Repository, als "owner/repo".
GITHUB_REPOSITORY=dein-username/dein-repo

# Die Nummer des zu reviewenden Pull Requests.
PR_NUMBER=1
